sql_database_names = [
	"Delivereats_SA",
	"Delivereats_SA_Usuarios",
	"Delivereats_SA_Productos",
	"Delivereats_SA_Restaurantes",
	"Delivereats_SA_Ordenes",
	"Delivereats_SA_Pagos",
]

