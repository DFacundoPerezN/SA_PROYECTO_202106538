#!/usr/bin/env bash
set -euo pipefail

export DEBIAN_FRONTEND=noninteractive

apt-get update
apt-get install -y ca-certificates curl docker.io

systemctl enable docker
systemctl start docker

docker pull mcr.microsoft.com/mssql/server:2022-latest
docker rm -f sqlserver >/dev/null 2>&1 || true
docker run -d \
  --name sqlserver \
  --restart unless-stopped \
  -e ACCEPT_EULA=Y \
  -e MSSQL_PID=Developer \
  -e MSSQL_SA_PASSWORD='${sql_server_password}' \
  -p 1433:1433 \
  mcr.microsoft.com/mssql/server:2022-latest

echo "Waiting for SQL Server to become ready"
until docker run --rm --network host mcr.microsoft.com/mssql-tools18:latest /opt/mssql-tools18/bin/sqlcmd -S 127.0.0.1 -U sa -P '${sql_server_password}' -C -Q "SELECT 1" >/dev/null 2>&1; do
  sleep 10
done

cat >/tmp/init.sql <<'EOF'
IF NOT EXISTS (SELECT name FROM sys.server_principals WHERE name = N'${sql_admin_username}')
BEGIN
  CREATE LOGIN [${sql_admin_username}] WITH PASSWORD = N'${sql_server_password}', CHECK_POLICY = OFF, CHECK_EXPIRATION = OFF;
END
ALTER SERVER ROLE [sysadmin] ADD MEMBER [${sql_admin_username}];
GO
%{ for db_name in sql_database_names ~}
IF DB_ID(N'${db_name}') IS NULL
BEGIN
  CREATE DATABASE [${db_name}];
END
GO
%{ endfor ~}
EOF

docker run --rm --network host -v /tmp/init.sql:/tmp/init.sql:ro mcr.microsoft.com/mssql-tools18:latest /opt/mssql-tools18/bin/sqlcmd -S 127.0.0.1 -U sa -P '${sql_server_password}' -C -i /tmp/init.sql

echo "SQL Server VM ready"