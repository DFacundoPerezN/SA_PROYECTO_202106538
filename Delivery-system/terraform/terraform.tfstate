            "metadata": {
              "enable-oslogin": "FALSE"
            },
            "metadata_fingerprint": "rEIiOOg69pk=",
            "metadata_startup_script": "#!/usr/bin/env bash\r\nset -euo pipefail\r\n\r\nexport DEBIAN_FRONTEND=noninteractive\r\n\r\napt-get update\r\napt-get install -y ca-certificates curl docker.io\r\n\r\nsystemctl enable docker\r\nsystemctl start docker\r\n\r\ndocker pull mcr.microsoft.com/mssql/server:2022-latest\r\ndocker rm -f sqlserver \u003e/dev/null 2\u003e\u00261 || true\r\ndocker run -d \\\r\n  --name sqlserver \\\r\n  --restart unless-stopped \\\r\n  -e ACCEPT_EULA=Y \\\r\n  -e MSSQL_PID=Developer \\\r\n  -e MSSQL_SA_PASSWORD='Delivereats123' \\\r\n  -p 1433:1433 \\\r\n  mcr.microsoft.com/mssql/server:2022-latest\r\n\r\necho \"Waiting for SQL Server to become ready\"\r\nuntil docker run --rm --network host mcr.microsoft.com/mssql-tools18:latest /opt/mssql-tools18/bin/sqlcmd -S 127.0.0.1 -U sa -P 'Delivereats123' -C -Q \"SELECT 1\" \u003e/dev/null 2\u003e\u00261; do\r\n  sleep 10\r\ndone\r\n\r\ncat \u003e/tmp/init.sql \u003c\u003c'EOF'\r\nIF NOT EXISTS (SELECT name FROM sys.server_principals WHERE name = N'adminsql')\r\nBEGIN\r\n  CREATE LOGIN [adminsql] WITH PASSWORD = N'Delivereats123', CHECK_POLICY = OFF, CHECK_EXPIRATION = OFF;\r\nEND\r\nALTER SERVER ROLE [sysadmin] ADD MEMBER [adminsql];\r\nGO\r\nIF DB_ID(N'Delivereats_SA') IS NULL\r\nBEGIN\r\n  CREATE DATABASE [Delivereats_SA];\r\nEND\r\nGO\r\nIF DB_ID(N'Delivereats_SA_Usuarios') IS NULL\r\nBEGIN\r\n  CREATE DATABASE [Delivereats_SA_Usuarios];\r\nEND\r\nGO\r\nIF DB_ID(N'Delivereats_SA_Productos') IS NULL\r\nBEGIN\r\n  CREATE DATABASE [Delivereats_SA_Productos];\r\nEND\r\nGO\r\nIF DB_ID(N'Delivereats_SA_Restaurantes') IS NULL\r\nBEGIN\r\n  CREATE DATABASE [Delivereats_SA_Restaurantes];\r\nEND\r\nGO\r\nIF DB_ID(N'Delivereats_SA_Ordenes') IS NULL\r\nBEGIN\r\n  CREATE DATABASE [Delivereats_SA_Ordenes];\r\nEND\r\nGO\r\nIF DB_ID(N'Delivereats_SA_Pagos') IS NULL\r\nBEGIN\r\n  CREATE DATABASE [Delivereats_SA_Pagos];\r\nEND\r\nGO\r\nEOF\r\n\r\ndocker run --rm --network host -v /tmp/init.sql:/tmp/init.sql:ro mcr.microsoft.com/mssql-tools18:latest /opt/mssql-tools18/bin/sqlcmd -S 127.0.0.1 -U sa -P 'Delivereats123' -C -i /tmp/init.sql\r\n\r\necho \"SQL Server VM ready\"",
